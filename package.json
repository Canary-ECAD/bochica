{
  "name": "bochica",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @bochica/desktop dev",
    "build": "bun run --filter @bochica/desktop build",
    "package": "bun run --filter @bochica/desktop package",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip && bun test"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "knip": "6.43.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "electron"
  ]
}
